{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --ignore-scripts",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://menuar-3nof.onrender.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://menuar-3nof.onrender.com/uploads/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
