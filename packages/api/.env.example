# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: cloud.mongodb.com → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGODB_DB_NAME=dishdekho

# ── Better Auth ─────────────────────────────────────────────────────────────
# Random 32-char secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_char_secret_here

# ── Google OAuth (Better Auth social login) ──────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Brevo Transactional Email API (Better Auth OTP verification) ────────────
# Get from: app.brevo.com → Settings → SMTP & API → API Keys tab.
# Uses the HTTP API rather than SMTP relay, since Brevo's SMTP access can be
# restricted to authorized IPs — that breaks on hosts with dynamic outbound IPs
# (e.g. Render). Leave blank in dev — verification code logs to console instead.
BREVO_API_KEY=
SMTP_FROM=noreply@dishdekho.app

# Where landing-page contact/newsletter inquiries are emailed (defaults to SMTP_FROM)
INQUIRY_NOTIFY_EMAIL=dishdekho72@gmail.com

# ── Admin JWT ────────────────────────────────────────────────────────────────
ADMIN_EMAILS=your@email.com
ADMIN_PASSWORD=
JWT_SECRET=your_jwt_secret

# ── Razorpay ────────────────────────────────────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Optional: cache the plan ID after first creation so you don't recreate on restart
RAZORPAY_PLAN_ID=plan_xxxx

# ── Cloudflare R2 (required — mandatory storage backend, no local-disk fallback) ─
# Get from: dash.cloudflare.com → R2 → Manage R2 API tokens
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=menuar-models
# Must be a PUBLICLY READABLE URL (not the *.r2.cloudflarestorage.com API endpoint).
# Enable the bucket's public "r2.dev" access or attach a custom domain, then paste
# that URL here — this is what customers' browsers load images/GLBs from.
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Third-Party APIs ─────────────────────────────────────────────────────────
REMOVE_BG_API_KEY=
TRIPO_API_KEY=
HUGGINGFACE_API_TOKEN=

# ── Gemini (digital menu OCR) ───────────────────────────────────────────────
# Get from: aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Server Config ────────────────────────────────────────────────────────────
PORT=3001
# API_URL is the base backend URL (e.g. https://menuar-2.onrender.com)
API_URL=
# WEB_URL is the base frontend URL (e.g. https://menuar-web.vercel.app)
WEB_URL=
