{
  "installCommand": "npm install --prefix=../.. --ignore-scripts",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://menuar-3nof.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://menuar-3nof.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
